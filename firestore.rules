rules_version = '2';

// ============================================================
// تدريب — قواعد أمان Firestore (مشروع moad-training)
// ============================================================
// تدفق الإعداد الأولي (bootstrap):
//   1. قبل وجود أي حساب، يقرأ التطبيق meta/setup (قراءة عامة) ليعرف
//      إن اكتمل الإعداد. المستند غائب = لم يكتمل.
//   2. بدر ينشئ حساب المدير الأول من شاشة الإعداد: حساب Auth، ثم
//      ملف users/{uid} بدور admin (مسموح ذاتياً ما دام الإعداد غير
//      مكتمل — انظر قاعدة users أدناه)، ثم meta/setup
//      {setupComplete: true} (الكتابة تتطلب ملف مدير موجوداً،
//      وهو موجود الآن لأنه أُنشئ في الخطوة نفسها).
//   3. بعدها يُغلق الباب: الإعداد لا يُعاد، ولا حسابات ذاتية أبداً —
//      المدير وحده ينشئ الحسابات من شاشة الإدارة.
// قيد معروف: نافذة الإعداد الأولي (قبل أن ينشئ بدر حسابه) يحميها
// بوابة setupComplete فقط. إن أكمل شخص آخر الإعداد أولاً، فالاستعادة
// تكون بحذف meta/setup + المستخدم الدخيل من وحدة تحكم Firebase.
// الأدوار: admin (مدير) / editor (محرر) / viewer (عارض). العارض
// يقرأ فقط ولا يكتب أبداً. سجل التدقيق: إنشاء فقط، ولا يُعدَّل أو يُحذف.
// قراءة البيانات تتطلب ملفاً شخصياً موجوداً وغير معطّل (hasProfile)
// لا مجرد تسجيل دخول — فحساب حُذف ملفه أو عُطّل لا يقرأ شيئاً.
// قفل الحساب: مجموعة loginAttempts (بصمة + طابع زمني فقط) — قراءة
// عامة وإنشاء مقيّد بالأنواع، لأن فحص القفل يحدث قبل تسجيل الدخول.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- مساعدات ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return profileExists() && getRole() == 'admin';
    }

    function isEditor() {
      return profileExists() && getRole() == 'editor';
    }

    function canWrite() {
      return isAdmin() || isEditor();
    }

    // ملف شخصي موجود وغير معطّل — شرط القراءة في كل مجموعات
    // البيانات: حساب حُذف ملفه أو عُطّل لا يقرأ شيئاً عبر واجهة
    // Firestore المباشرة حتى لو بقي رمز الدخول (token) صالحاً
    // (حساب Auth نفسه يبقى في وحدة التحكم حتى يحذفه المدير يدوياً).
    // ⚠️ لا تستخدم .data.disabled مباشرة: الملفات لا تحوي حقل
    // disabled أصلاً (يُضاف فقط عند التعطيل)، والوصول لحقل غائب
    // بنقطة (.) يُسقط القاعدة كلها (رفض). .get(..., false) آمن.
    function hasProfile() {
      return profileExists() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true;
    }

    function setupComplete() {
      return exists(/databases/$(database)/documents/meta/setup) &&
        get(/databases/$(database)/documents/meta/setup).data.setupComplete == true;
    }

    // ---------- الإعداد (meta/setup) ----------
    // القراءة عامة: التطبيق يحتاجها قبل تسجيل الدخول ليعرف إن كان
    // الإعداد الأولي مطلوباً.
    match /meta/setup {
      allow read: if true;
      // الإنشاء: مدير مسجّل دخوله وملفه موجود (يحدث في الإعداد الأولي
      // بعد إنشاء ملف المدير مباشرة).
      allow create: if isAdmin();
      // التحديث: مدير فقط، ومن «غير مكتمل» إلى «مكتمل» فقط — لا رجوع.
      allow update: if isAdmin()
        && resource.data.setupComplete == false
        && request.resource.data.setupComplete == true;
      allow delete: if false;
    }
    // ---------- الإعدادات العامة (meta/general) ----------
    // أيام العطلة الأسبوعية (v2.3): القراءة لأي مسجّل دخول بملف
    // شخصي نشط؛ الكتابة للمدير فقط؛ لا حذف أبداً.
    match /meta/general {
      allow read: if hasProfile();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    // أي مستند meta آخر: مغلق تماماً.
    match /meta/{other} {
      allow read, write: if false;
    }

    // ---------- المستخدمون ----------
    match /users/{userId} {
      // القراءة: ملفي الشخصي، أو المدير يقرأ الجميع.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // الإنشاء: مدير فقط — إلا الإنشاء الذاتي في الإعداد الأولي:
      // المستخدم ينشئ ملفه هو، بدور admin، ما دام الإعداد غير مكتمل.
      allow create: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == userId
            && !setupComplete()
            && request.resource.data.role == 'admin');
      allow update, delete: if isAdmin();
    }

    // ---------- بيانات المنصة ----------
    // القراءة لأي مسجّل دخول (كل الأدوار)؛ الكتابة للمدير والمحرر فقط.
    match /courses/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    match /sessions/{sessionId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();

      // حضور الجلسة (مجموعة فرعية).
      match /attendance/{traineeId} {
        allow read: if hasProfile();
        allow create, update, delete: if canWrite();
      }
    }

    match /meetings/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    match /trainees/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    match /trainers/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    // دليل الدورات (v2.3.1 — مجموعة جديدة courseNames): أسماء
    // المناهج التي تُبنى عليها مجموعات التدريب — نفس نمط بيانات
    // الدليل (قراءة لأي ملف شخصي، كتابة للمدير/المحرر).
    match /courseNames/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    match /directorates/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    match /groups/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    match /levels/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    match /halls/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    match /periods/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    match /holidays/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    match /expenses/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    match /budgetCategories/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    // ---------- الملاحظات (Badr 17:36: ملاحظة على أي شيء) ----------
    match /notes/{docId} {
      allow read: if hasProfile();
      allow create, update, delete: if canWrite();
    }

    // ---------- سجل التدقيق ----------
    // الإنشاء لأي مسجّل دخول بملف شخصي نشط؛ القراءة لأي مسجّل
    // دخول بملف شخصي نشط (صفحة التنبيهات v2.3)؛ لا تعديل ولا
    // حذف أبداً.
    match /audit/{docId} {
      allow create: if hasProfile();
      allow read: if hasProfile();
      allow update, delete: if false;
    }

    // ---------- محاولات الدخول (قفل الحساب) ----------
    // المستندات تحوي بصمة SHA-256 لاسم المستخدم + طابعاً زمنياً فقط
    // (أو علامة قفل locked: true) — بلا أسماء مستخدمين ولا كلمات
    // مرور ولا أي بيانات شخصية. القراءة عامة لأن فحص القفل يحدث
    // قبل تسجيل الدخول (بلا مصادقة)؛ الإنشاء مقيّد بالمفاتيح
    // والأنواع تماماً؛ التعديل والحذف للمدير فقط (تنظيف).
    // تنبيه: البصمة غير مملّحة — من يعرف اسم مستخدم يستطيع حساب
    // بصمته وكتابة محاولات مزيّفة لقفل الحساب 15 دقيقة (إزعاج
    // محدود المدة، لا اختراق). تُنظَّف المستندات القديمة يدوياً
    // من وحدة التحكم (لا تنظيف تلقائي في العميل).
    match /loginAttempts/{docId} {
      allow read: if true;
      allow create: if (request.resource.data.keys().hasOnly(['u', 'at'])
          && request.resource.data.u is string
          && request.resource.data.at is timestamp)
        || (request.resource.data.keys().hasOnly(['u', 'at', 'locked'])
          && request.resource.data.u is string
          && request.resource.data.at is timestamp
          && request.resource.data.locked is bool
          && request.resource.data.locked == true);
      allow update, delete: if isAdmin();
    }

    // ---------- رفض افتراضي لكل ما عداه ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
